{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "scheme": [
      "expensetracker",
      "com.googleusercontent.apps.802819595641-cujlud3r1onovi2ue2ukncmnq1rnt9sc",
      "com.googleusercontent.apps.802819595641-csin72b5gufoqkl8t62sb6ul9u1iesi7"
